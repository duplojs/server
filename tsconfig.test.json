{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
	"types": ["vitest/globals", "node", "deno", "bun"],
    "paths": {
	  "@scripts": ["./scripts/index.ts"],
      "@scripts/*": ["./scripts/*"],
      "@tests/*": ["./tests/*"],
    },
  },
  "include": [
	"tests/**/*.ts",
	"scripts/**/*.ts", 
	"integrations/bun/tsconfig.json",
	"integrations/node/tsconfig.json",
  ],
}
