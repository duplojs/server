{
  "name": "@duplojs/server",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "DuploJS",
    "url": "https://github.com/duplojs"
  },
  "description": "Typed helpers to handle files, system operations, and CLI commands.",
  "homepage": "https://server.duplojs.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duplojs/server.git"
  },
  "scripts": {
    "build": "./.commands/build.sh",
    "test:ut": "./.commands/test-ut.sh",
    "test:ut:watch": "./.commands/test-ut.sh --watch",
    "test:integrations:node": "./.commands/test-integrations.sh node",
    "test:integrations:bun": "./.commands/test-integrations.sh bun",
    "test:integrations:deno": "./.commands/test-integrations.sh deno",
    "test:types": "./.commands/test-types.sh",
    "test:types:target": "./.commands/test-types-target.sh",
    "test:lint": "./.commands/test-lint.sh",
    "test:lint:fix": "./.commands/test-lint.sh --fix",
    "prepare": "husky"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./file": {
      "import": "./dist/file/index.mjs",
      "require": "./dist/file/index.cjs",
      "types": "./dist/file/index.d.ts"
    },
    "./common": {
      "import": "./dist/common/index.mjs",
      "require": "./dist/common/index.cjs",
      "types": "./dist/common/index.d.ts"
    },
    "./dataStructure": {
      "import": "./dist/dataStructure/index.mjs",
      "require": "./dist/dataStructure/index.cjs",
      "types": "./dist/dataStructure/index.d.ts"
    },
    "./command": {
      "import": "./dist/command/index.mjs",
      "require": "./dist/command/index.cjs",
      "types": "./dist/command/index.d.ts"
    }
  },
  "peerDependencies": {
    "@duplojs/lang": "0.0.1-beta.11"
  },
  "devDependencies": {
    "@duplojs/code-config": "0.2.0",
    "oxlint": "1.82.0",
    "@types/bun": "1.4.1",
    "@types/deno": "2.7.0",
    "@types/node": "24.13.3",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-istanbul": "5.0.0",
    "husky": "9.1.7",
    "rolldown": "1.2.7",
    "tscw-config": "1.1.2",
    "tslib": "2.8.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unplugin-dts": "1.1.0",
    "vitest": "5.0.0"
  },
  "workspaces": [
    "integrations",
    "docs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "duplojs",
    "file",
    "fileSystem",
    "cli",
    "command",
    "dotenv",
    "env",
    "server-utils"
  ],
  "engines": {
    "node": ">=24.18.0"
  }
}
